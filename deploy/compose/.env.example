APP_ORIGIN=https://checkpoint.example.com
APP_PORT=4310
CHECKPOINT_IMAGE=ghcr.io/rdpr/checkpoint:0.4.0
AUTH_MODE=optional
# Actual proxy source IPs/CIDRs as seen by the app; see installation guidance.
TRUSTED_PROXIES=
# Link administrator accounts before enforcing AUTH_MODE=oidc.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_SECRET_FILE=./secrets/oidc_client_secret
# Defaults to openid profile email. Leave prompt empty to let the provider decide.
OIDC_SCOPES=
OIDC_PROMPT=
# Set true to sign out at the provider too (requires end_session_endpoint).
OIDC_LOGOUT_REDIRECT=
METRICS_SECRET_FILE=./secrets/metrics_token
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION=14
