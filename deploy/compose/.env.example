APP_ORIGIN=https://checkpoint.example.com
APP_PORT=4310
CHECKPOINT_IMAGE=ghcr.io/rdpr/checkpoint:0.3.1
AUTH_MODE=optional
# Actual proxy source IPs/CIDRs as seen by the app; see installation guidance.
TRUSTED_PROXIES=
# Link administrator accounts before enforcing AUTH_MODE=entra.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_SECRET_FILE=./secrets/entra_client_secret
METRICS_SECRET_FILE=./secrets/metrics_token
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION=14
