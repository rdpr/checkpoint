{
  "name": "checkpoint",
  "version": "0.3.1",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web 'node --import tsx --watch server/index.ts' 'vite --host 127.0.0.1'",
    "build": "vite build && node ops/licenses.mjs",
    "start": "node --import tsx server/index.ts",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "test:portable": "node --import tsx --test tests/portable.e2e.ts",
    "test:containers": "python3 ops/test-container.py",
    "test:kubernetes": "python3 ops/test-kubernetes.py",
    "release:check": "node --import tsx ops/release.ts check",
    "release:package": "node --import tsx ops/release.ts package"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/geist-mono": "^5.2.0",
    "@fontsource-variable/inter": "^5.2.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@plannotator/core": "0.25.12",
    "@plannotator/ui": "0.52.1",
    "@prometheus-io/client": "0.16.1",
    "express": "^5.1.0",
    "katex": "0.18.2",
    "lucide-react": "^1.54.0",
    "marked": "17.0.6",
    "openid-client": "6.8.8",
    "parse5": "8.0.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "overrides": {
    "lodash-es": "4.18.1",
    "katex": "$katex"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/express": "^5.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "description": "Review specs, designs, and agent work with your engineering team.",
  "repository": {
    "type": "git",
    "url": "https://github.com/rdpr/checkpoint.git"
  },
  "homepage": "https://github.com/rdpr/checkpoint",
  "bugs": {
    "url": "https://github.com/rdpr/checkpoint/issues"
  }
}
